[Unit]
Description=Ocean intelligence isolated processing worker
After=network.target postgresql.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/ocean-intelligence/current
EnvironmentFile=/opt/knowledge-base/.env
EnvironmentFile=-/opt/ocean-intelligence/processing.env
Environment=INTEL_DATA_DIR=/opt/ocean-intelligence/data
Environment=INTEL_PROCESSING_PORT=3105
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/usr/bin/node --expose-gc intelligence/processing-service.mjs
Restart=on-failure
RestartSec=900
KillMode=control-group
TimeoutStopSec=60
MemoryHigh=2500M
MemoryMax=3G
MemorySwapMax=0
CPUQuota=100%
Nice=10
IOSchedulingClass=idle
IOReadBandwidthMax=/dev/vda 12M
IOWriteBandwidthMax=/dev/vda 4M
TasksMax=128

[Install]
WantedBy=multi-user.target
