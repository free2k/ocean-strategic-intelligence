[Unit]
Description=Publish committed ocean workspace and object archives
After=network-online.target
[Service]
Type=oneshot
EnvironmentFile=/opt/ocean-intelligence/research-publish.env
WorkingDirectory=/opt/ocean-intelligence/current
ExecStart=/usr/bin/flock -n -E 75 /opt/ocean-intelligence/eia-daily.lock /usr/bin/node --env-file=/opt/knowledge-base/.env /opt/ocean-intelligence/current/intelligence/research/publish-workspace-cli.mjs
SuccessExitStatus=75
TimeoutStartSec=15min
UMask=0077
