[Unit]
Description=Update ocean intelligence EIA monthly series
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/ocean-intelligence/eia-daily.sh
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=INTEL_PROCESSING_WORKER=true
MemoryHigh=2500M
MemoryMax=3G
MemorySwapMax=0
CPUQuota=100%
Nice=10
IOSchedulingClass=idle
IOReadBandwidthMax=/dev/vda 12M
IOWriteBandwidthMax=/dev/vda 4M
