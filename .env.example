# PostgreSQL 连接（需要安装 pgvector 扩展）
DATABASE_URL=postgresql://postgres:password@localhost:5432/knowledge_base

# OpenAI 兼容 API 配置
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# CHAT_MODEL=gpt-4o-mini

# AI — Embedding
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4

# Legacy LLM vars for ai.service.ts
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 兼容 API 配置
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus

# 文章下载代理（用于访问 .workers.dev 等被墙域名）
# 设置为你本地代理地址，例如 Clash/V2Ray 的 HTTP 代理端口
# DOWNLOAD_PROXY=http://127.0.0.1:7890

# 邮件推送 SMTP 配置
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_password
SMTP_FROM=your_email@163.com

# 站点访问密码（留空则不启用访问控制）
SITE_PASSWORD=changeme

# Mp2RSS feed URLs are credentials: keep only in server-side environment configuration.
# MP2_RSS_LINK=https://mp2rss.bugcode.dev/feed/YOUR_PRIMARY_KEY/rss/all
# Additional accounts (JSON array); channels are merged by platform + remote ID.
MP2_RSS_EXTRA_LINKS='[]'

# Model cost controls: routine text is routed separately from QA/research.
INTEL_MODEL_CLASSIFICATION=qwen3.7-flash
INTEL_MODEL_TRANSLATION=qwen3.7-flash
INTEL_MODEL_SUMMARY=qwen3.7-flash
# PDF and >12000-character documents get an excerpt-based summary automatically.
# Existing full translations are retained. Set full only to restore old behavior.
INTEL_TRANSLATION_MODE=on_demand
INTEL_AUTO_VISION=false
# Enable only after installing model-operations.service/timer in the same release.
INTEL_MODEL_WORKER_ENABLED=false
# Preserve existing workspace rows/files when restarting a code-only release.
# Explicit imports and newly scheduled processing keep their normal behavior.
INTEL_PRESERVE_STARTUP_DATA=true
# File-input Batch is opt-in: it has separate billing and no free-tier deduction.
# No fallback to realtime is performed if Batch fails or its result is uncertain.
INTEL_BATCH_ENABLED=false
# OPENAI_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BATCH_API_KEY=your-authorized-batch-key
