# PostgreSQL 连接（需要安装 pgvector 扩展）
DATABASE_URL=postgresql://postgres:password@localhost:5432/knowledge_base

# OpenAI 兼容 API 配置
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# CHAT_MODEL=gpt-4o-mini

# AI — Embedding
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4

# Legacy LLM vars for ai.service.ts
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-dcf573eb6cfe492aa0bf4b4770f262e8
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 兼容 API 配置
OPENAI_API_KEY=sk-dcf573eb6cfe492aa0bf4b4770f262e8
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus

# 文章下载代理（用于访问 .workers.dev 等被墙域名）
# 设置为你本地代理地址，例如 Clash/V2Ray 的 HTTP 代理端口
# DOWNLOAD_PROXY=http://127.0.0.1:7890